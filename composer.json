{
    "name": "kovami/htmldocx",
    "description": "Dependency-free PHP library that converts HTML to DOCX (Office Open XML) and DOCX back to HTML. Framework-agnostic, with no runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/kovami/htmldocx",
    "authors": [
        {
            "name": "kovami",
            "email": "alexandr.minakov178@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/kovami/htmldocx/issues",
        "source": "https://github.com/kovami/htmldocx"
    },
    "keywords": [
        "html",
        "docx",
        "word",
        "ooxml",
        "converter",
        "html-to-docx",
        "docx-to-html"
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-xmlwriter": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "ext-zip": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.2"
    },
    "suggest": {
        "ext-gd": "Converts WebP images (unsupported by Word) to PNG before embedding."
    },
    "autoload": {
        "psr-4": {
            "Kovami\\HtmlDocx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kovami\\HtmlDocx\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
